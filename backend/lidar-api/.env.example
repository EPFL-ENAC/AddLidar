# Container image configuration
IMAGE_NAME=ghcr.io/epfl-enac/lidardatamanager
IMAGE_TAG=latest

# Volume and path configuration
MOUNT_PATH=/data
OUTPUT_PATH=/output
DATABASE_PATH=/data/database.sqlite
PATH_PREFIX=
DEFAULT_OUTPUT_ROOT=/output

# Kubernetes configuration
NAMESPACE=epfl-eso-addlidar-dev
PVC_OUTPUT_NAME=lidar-data-output-pvc
PVC_NAME=lidar-data-pvc
JOB_TIMEOUT=300

# Keycloak configuration
KEYCLOAK_REALM=your-realm-here
KEYCLOAK_URL=https://enac-it-sso2.epfl.ch/auth
KEYCLOAK_API_ID=your-client-id-here
KEYCLOAK_API_SECRET=your-secret-here